{
  "name": "nyx",
  "version": "0.8.0",
  "type": "module",
  "description": "Verifiable, on-device edge-AI copilot built on the QVAC SDK",
  "license": "Apache-2.0",
  "scripts": {
    "setup": "node scripts/setup-models.js && node -e \"import('./src/rag.js').then(m=>m.buildIndex())\"",
    "model": "npm i @qvac/sdk && node scripts/setup-models.js",
    "keys": "node scripts/gen-keys.js",
    "start": "node server.js",
    "bench": "node scripts/bench.js",
    "verify": "node verify.js",
    "demo": "bash scripts/demo.sh",
    "hwproof": "node scripts/hwproof.js",
    "evidence": "node scripts/evidence.js",
    "desktop": "electron .",
    "dist": "node scripts/ensure-icon.mjs && electron-builder",
    "dist:win": "node scripts/ensure-icon.mjs && electron-builder --win",
    "dist:mac": "node scripts/ensure-icon.mjs && electron-builder --mac",
    "dist:linux": "node scripts/ensure-icon.mjs && electron-builder --linux"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "electron-updater": "^6.3.9"
  },
  "optionalDependencies": {
    "systeminformation": "^5.22.0",
    "@qvac/sdk": "^0.13.5"
  },
  "main": "electron/main.cjs",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.nyx.desktop",
    "productName": "Nyx",
    "asar": false,
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nyx",
      "runAfterFinish": true,
      "allowToChangeInstallationDirectory": true,
      "include": "nsis/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "aar0n4ik",
        "repo": "Nyx"
      }
    ],
    "protocols": [
      {
        "name": "Nyx Protocol",
        "schemes": [
          "nyx"
        ]
      }
    ],
    "artifactName": "Nyx-Setup.${ext}",
    "files": [
      "**/*",
      "!**/*.map",
      "!**/*.bak",
      "!evidence/**",
      "!**/*.md",
      "!**/node_modules/@qvac/translation-nmtcpp/**",
      "!**/node_modules/@qvac/vla-ggml/**",
      "!**/node_modules/@qvac/diffusion-cpp/**",
      "!**/node_modules/@qvac/transcription-whispercpp/**",
      "!**/node_modules/@qvac/transcription-parakeet/**",
      "!**/node_modules/@qvac/tts-ggml/**",
      "!**/node_modules/@qvac/ocr-onnx/**",
      "!**/node_modules/@qvac/bci-whispercpp/**",
      "!**/node_modules/bare-ffmpeg/**",
      "!**/*.ts",
      "!**/*.h",
      "!**/*.hpp",
      "!**/*.c",
      "!**/*.cc",
      "!**/*.cpp",
      "!**/*.lib",
      "!**/*.a",
      "!**/*.pdb",
      "!**/*.exp",
      "!**/test/**",
      "!**/tests/**",
      "!**/example/**",
      "!**/examples/**",
      "!**/docs/**",
      "!**/.github/**"
    ]
  }
}
