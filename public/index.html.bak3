var $=function(s,r){return (r||document).querySelector(s)},$$=function(s,r){return [].slice.call((r||document).querySelectorAll(s))};
function getTheme(){var t;try{t=localStorage.getItem('nyx-theme')}catch(e){}if(!t)t=matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';return t==='light'?'light':'dark';}
function setTheme(t,ev){t=t==='light'?'light':'dark';var r=document.documentElement,go=function(){r.setAttribute('data-theme',t);try{localStorage.setItem('nyx-theme',t)}catch(e){}};if(ev){r.style.setProperty('--x',ev.clientX+'px');r.style.setProperty('--y',ev.clientY+'px');}if(document.startViewTransition&&!matchMedia('(prefers-reduced-motion: reduce)').matches)document.startViewTransition(go);else go();}
function getLang(){var l;try{l=localStorage.getItem('nyx.lang')}catch(e){}if(!l){var n=(navigator.language||'en').slice(0,2).toLowerCase();l=SUP.indexOf(n)>=0?n:'en';}return SUP.indexOf(l)>=0?l:'en';}
function setLang(l){if(SUP.indexOf(l)<0)l='en';try{localStorage.setItem('nyx.lang',l)}catch(e){}apply(l);}
function apply(l){var d=T[l]||T.en;document.documentElement.setAttribute('lang',l);$$('[data-i18n]').forEach(function(e){var v=d[e.getAttribute('data-i18n')];if(v!=null)e.textContent=v;});$$('[data-i18n-html]').forEach(function(e){var v=d[e.getAttribute('data-i18n-html')];if(v!=null)e.innerHTML=v;});$$('[data-lang-label]').forEach(function(e){e.textContent=LAB[l];});if(d.doc_title)document.title=d.doc_title;$$('#langMenu button').forEach(function(b){b.setAttribute('aria-selected',b.getAttribute('data-l')===l?'true':'false');});}
document.documentElement.setAttribute('data-theme',getTheme());
var lm=$('#langMenu');SUP.forEach(function(l){var b=document.createElement('button');b.setAttribute('data-l',l);b.textContent=NAME[l];b.onclick=function(){setLang(l);$('#lang').classList.remove('open');};lm.appendChild(b);});
$('#langBtn').onclick=function(e){e.stopPropagation();$('#lang').classList.toggle('open');};
document.addEventListener('click',function(e){if(!$('#lang').contains(e.target))$('#lang').classList.remove('open');});
$('#themeBtn').onclick=function(e){setTheme(getTheme()==='dark'?'light':'dark',e);};
var nav=$('#nav');addEventListener('scroll',function(){nav.classList.toggle('scrolled',scrollY>10);});
var io=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});},{threshold:.12});$$('.reveal').forEach(function(e){io.observe(e);});
function cnt(el){var tg=parseFloat(el.getAttribute('data-target'))||0,sf=el.getAttribute('data-suffix')||'',st=performance.now(),du=1400;function f(n){var p=Math.min(1,(n-st)/du),e=1-Math.pow(1-p,3);el.textContent=Math.round(tg*e)+sf;if(p<1)requestAnimationFrame(f);}requestAnimationFrame(f);}
var io2=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){cnt(x.target);io2.unobserve(x.target);}});},{threshold:.5});$$('.metric .num').forEach(function(e){io2.observe(e);});
var LINES=[{p:'you',c:'cmd',t:'install Steam for me'},{p:'nyx',c:'ok',t:'downloading + installing… done, offline-ready'},{p:'you',c:'cmd',t:'back up my whole setup'},{p:'nyx',c:'ok',t:'snapshot saved → nyx-snapshot.json (48 KB)'},{p:'you',c:'cmd',t:'delete C:\\Windows\\System32'},{p:'nyx',c:'bad',t:'blocked — destructive command refused'}];
var host=$('#termBody');
function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function line(l,txt,car){return '<div class="tline"><span class="tp '+(l.p==='you'?'tyou':'tnyx')+'">'+(l.p==='you'?'you ›':'nyx')+'</span><span class="tt '+l.c+'">'+esc(txt)+(car?'<i class="caret"></i>':'')+'</span></div>';}
if(matchMedia('(prefers-reduced-motion: reduce)').matches){host.innerHTML=LINES.map(function(l){return line(l,l.t,false);}).join('');}
else{var done=[],li=0,ci=0;function draw(cur,par){host.innerHTML=done.join('')+(cur?line(cur,par,true):'');}function tick(){if(li>=LINES.length){setTimeout(function(){done=[];li=0;ci=0;draw();tick();},2600);return;}var l=LINES[li];ci++;var par=l.t.slice(0,ci);draw(l,par);if(ci>=l.t.length){done.push(line(l,l.t,false));li++;ci=0;setTimeout(tick,l.p==='you'?380:640);}else setTimeout(tick,20+Math.random()*38);}draw();tick();}
apply(getLang());
addEventListener('storage',function(e){if(e.key==='nyx-theme')document.documentElement.setAttribute('data-theme',getTheme());if(e.key==='nyx.lang')apply(getLang());});
})();
</script>
</body>
</html>
