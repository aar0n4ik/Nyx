</div></footer>
<script>
(function(){
"use strict";
var $=function(s,r){return (r||document).querySelector(s)};
var $$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};// ---- theme ----
var themeBtn=$('#theme');
function setTheme(t,e){
  var run=function(){document.documentElement.setAttribute('data-theme',t);try{localStorage.setItem('nyx-theme',t)}catch(err){}};
  if(e){var x=(e.clientX/innerWidth*100).toFixed(1),y=(e.clientY/innerHeight*100).toFixed(1);document.documentElement.style.setProperty('--x',x+'%');document.documentElement.style.setProperty('--y',y+'%');}
  if(document.startViewTransition){document.startViewTransition(run)}else{run()}
}
themeBtn.addEventListener('click',function(e){var cur=document.documentElement.getAttribute('data-theme');setTheme(cur==='dark'?'light':'dark',e)});

// ---- reveal ----
var io=new IntersectionObserver(function(es){es.forEach(function(en){if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target)}})},{threshold:0.12,rootMargin:'0px 0px -8% 0px'});
$$('.reveal').forEach(function(n){io.observe(n)});
setTimeout(function(){$$('.reveal').forEach(function(n){n.classList.add('in')})},1500);

// ---- counters ----
var cio=new IntersectionObserver(function(es){es.forEach(function(en){if(!en.isIntersecting)return;cio.unobserve(en.target);var el=en.target,to=parseFloat(el.getAttribute('data-target'))||0,t0=null,dur=1400;function step(ts){if(!t0)t0=ts;var p=Math.min(1,(ts-t0)/dur);var e=1-Math.pow(1-p,3);el.textContent=Math.round(to*e).toString();if(p<1)requestAnimationFrame(step)}requestAnimationFrame(step)})},{threshold:0.6});
$$('.metric .n').forEach(function(n){cio.observe(n)});

// ---- chat demo ----
var body=$('#chatBody'),timers=[],logo='logo.svg';
function esc(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function at(ms,fn){timers.push(setTimeout(fn,ms))}
function clearDemo(){timers.forEach(clearTimeout);timers=[];if(body)body.innerHTML=''}
function youMsg(text){var m=document.createElement('div');m.className='msg you';m.innerHTML='<div class="bubble">'+esc(text)+'</div>';body.appendChild(m);return m}
function nyxWrap(){var m=document.createElement('div');m.className='msg nyx';m.innerHTML='<div class="av"><img src="'+logo+'" alt=""></div><div class="bubble"></div>';body.appendChild(m);return m.querySelector('.bubble')}
function typeInto(el,text,done){var i=0;el.innerHTML='<span class="cur caret"></span>';function tick(){i++;el.innerHTML=esc(text.slice(0,i))+'<span class="cur caret"></span>';if(i<text.length){at(16+Math.random()*22,tick)}else{el.innerHTML=esc(text);if(done)done()}}at(120,tick)}
function typingBubble(){var m=document.createElement('div');m.className='msg nyx';m.innerHTML='<div class="av"><img src="'+logo+'" alt=""></div><div class="bubble"><span class="typing"><i></i><i></i><i></i></span></div>';body.appendChild(m);return m}
var CK='<svg class="ck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>';
function buildDemo(d){
  clearDemo();
  at(300,function(){youMsg(d.dm_q)});
  var tb;
  at(900,function(){tb=typingBubble()});
  at(1900,function(){
    if(tb)tb.remove();
    var b=nyxWrap();
    typeInto(b,d.dm_a1,function(){
      var plan=document.createElement('div');plan.className='plan';
      plan.innerHTML='<div class="plan-h">'+esc(d.dm_plan)+'</div>'+
        '<div class="plan-row">'+CK+'<span>'+esc(d.dm_i1)+'</span><span class="amt">faster boot</span></div>'+
        '<div class="plan-row">'+CK+'<span>'+esc(d.dm_i2)+'</span><span class="amt">safe</span></div>'+
        '<div class="plan-row">'+CK+'<span>'+esc(d.dm_i3)+'</span><span class="amt">+2.6 GB</span></div>'+
        '<div class="plan-row" style="color:var(--faint)"><span class="amt" style="margin-left:0">'+esc(d.dm_more)+'</span></div>'+
        '<div class="plan-actions"><button class="mini primary" id="apv">'+esc(d.dm_approve)+'</button><button class="mini">'+esc(d.dm_edit)+'</button></div>';
      b.appendChild(plan);
      at(1400,function(){var a=$('#apv');if(a)a.classList.add('clicked')});
      at(1750,function(){youMsg(d.dm_approve)});
      var tb2;at(2100,function(){tb2=typingBubble()});
      at(3100,function(){if(tb2)tb2.remove();var b2=nyxWrap();
        b2.innerHTML='<div class="done"><span class="ok">'+CK+'</span><span>'+esc(d.dm_a2)+'</span></div><toggle class="nyx-verify"><summary class="nyx-verify-chip"><span class="vok">✓</span> Verified<div class="nyx-verify-card"><div class="vrow"><b>What ran</b><span>Trimmed 14 startup apps, cleared 8.4 GB, closed 3 tasks</span></div><div class="vrow"><b>What changed</b><span>Startup list, temp cache, background processes</span></div><div class="vrow"><b>Reversible</b><span>Yes — one-click undo</span></div><div class="vrow"><b>Signed</b><span><code>a1f9…c7e2</code> · Ed25519</span></div></div></toggle>';
      });
      at(6800,function(){buildDemo(d)});
    });
  });
}

// ---- nav + progress ----
var nav=$('#nav'),prog=$('#progress');
function onScroll(){var y=scrollY||document.documentElement.scrollTop;nav.classList.toggle('scrolled',y>10);var h=document.documentElement.scrollHeight-innerHeight;prog.style.width=(h>0?(y/h*100):0)+'%'}
addEventListener('scroll',onScroll,{passive:true});onScroll();
buildDemo({dm_q:"My PC's been crawling all week — can you speed it up?",dm_a1:"Found the main culprits. Here's what I'd change — I won't touch anything until you say go.",dm_plan:"Proposed fixes",dm_i1:"Trim 14 startup apps",dm_i2:"Clear 8.4 GB temp & cache",dm_i3:"Close 3 stuck background tasks",dm_more:"Nothing removed without asking",dm_approve:"Approve",dm_edit:"Edit plan",dm_a2:"Done — your PC feels light again.",dm_receipt:"Signed receipt → ./evidence"});
})();
</script>
<script>

</script>
<script src="/models.js"></script><script src="/cards.js"></script><script src="/launch.js"></script><script src="/download.js"></script>

<style id="nyx-typo-fix">
/* NYX_TYPO_FIX: TurboQuant note + download steps -> обычный шрифт тела, без капса, легче */
.mnote{align-items:center}
.mnote p{font-family:inherit !important;font-weight:400 !important;text-transform:none !important;letter-spacing:normal !important}
.mnote b{font-weight:600 !important;text-transform:none !important}
.istep h3{font-family:inherit !important;font-weight:600 !important;text-transform:none !important;letter-spacing:normal !important}
.istep p{font-family:inherit !important;text-transform:none !important}
</style>
</body>
</html>
