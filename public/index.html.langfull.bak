// ---- language ----
var lang=(function(){try{var s=localStorage.getItem('nyx.lang');if(s&&T[s])return s;var n=(navigator.language||'en').slice(0,2);return T[n]?n:'en'}catch(e){return 'en'}})();
function apply(l){
  var d=T[l]||T.en;lang=l;
  $$('[data-i18n]').forEach(function(el){var k=el.getAttribute('data-i18n');if(d[k]!=null)el.textContent=d[k]});
  var lab=$('[data-lang-label]');if(lab)lab.textContent=LAB[l]||'EN';
  document.documentElement.setAttribute('lang',l);
  document.title='Nyx \u2014 '+(d.hero_h1||'your local PC copilot');
  $$('#langMenu button').forEach(function(b){b.setAttribute('aria-selected',b.getAttribute('data-l')===l?'true':'false')});
  buildDemo(d);
}
var langEl=$('#lang'),langBtn=$('#langBtn');
langBtn.addEventListener('click',function(e){e.stopPropagation();langEl.classList.toggle('open')});
document.addEventListener('click',function(){langEl.classList.remove('open')});
$$('#langMenu button').forEach(function(b){b.addEventListener('click',function(){var l=b.getAttribute('data-l');try{localStorage.setItem('nyx.lang',l)}catch(e){}apply(l);langEl.classList.remove('open')})});

// ---- theme ----
var themeBtn=$('#theme');
function setTheme(t,e){
  var run=function(){document.documentElement.setAttribute('data-theme',t);try{localStorage.setItem('nyx-theme',t)}catch(err){}};
  if(e){var x=(e.clientX/innerWidth*100).toFixed(1),y=(e.clientY/innerHeight*100).toFixed(1);document.documentElement.style.setProperty('--x',x+'%');document.documentElement.style.setProperty('--y',y+'%');}
  if(document.startViewTransition){document.startViewTransition(run)}else{run()}
}
themeBtn.addEventListener('click',function(e){var cur=document.documentElement.getAttribute('data-theme');setTheme(cur==='dark'?'light':'dark',e)});

// ---- reveal ----
var io=new IntersectionObserver(function(es){es.forEach(function(en){if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target)}})},{threshold:0.12,rootMargin:'0px 0px -8% 0px'});
$$('.reveal').forEach(function(n){io.observe(n)});
setTimeout(function(){$$('.reveal').forEach(function(n){n.classList.add('in')})},1500);

// ---- counters ----
var cio=new IntersectionObserver(function(es){es.forEach(function(en){if(!en.isIntersecting)return;cio.unobserve(en.target);var el=en.target,to=parseFloat(el.getAttribute('data-target'))||0,t0=null,dur=1400;function step(ts){if(!t0)t0=ts;var p=Math.min(1,(ts-t0)/dur);var e=1-Math.pow(1-p,3);el.textContent=Math.round(to*e).toString();if(p<1)requestAnimationFrame(step)}requestAnimationFrame(step)})},{threshold:0.6});
$$('.metric .n').forEach(function(n){cio.observe(n)});

// ---- chat demo ----
var body=$('#chatBody'),timers=[],logo='logo.svg';
function esc(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function at(ms,fn){timers.push(setTimeout(fn,ms))}
function clearDemo(){timers.forEach(clearTimeout);timers=[];if(body)body.innerHTML=''}
function youMsg(text){var m=document.createElement('div');m.className='msg you';m.innerHTML='<div class="bubble">'+esc(text)+'</div>';body.appendChild(m);return m}
function nyxWrap(){var m=document.createElement('div');m.className='msg nyx';m.innerHTML='<div class="av"><img src="'+logo+'" alt=""></div><div class="bubble"></div>';body.appendChild(m);return m.querySelector('.bubble')}
function typeInto(el,text,done){var i=0;el.innerHTML='<span class="cur caret"></span>';function tick(){i++;el.innerHTML=esc(text.slice(0,i))+'<span class="cur caret"></span>';if(i<text.length){at(16+Math.random()*22,tick)}else{el.innerHTML=esc(text);if(done)done()}}at(120,tick)}
function typingBubble(){var m=document.createElement('div');m.className='msg nyx';m.innerHTML='<div class="av"><img src="'+logo+'" alt=""></div><div class="bubble"><span class="typing"><i></i><i></i><i></i></span></div>';body.appendChild(m);return m}
var CK='<svg class="ck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>';
function buildDemo(d){
  clearDemo();
  at(300,function(){youMsg(d.dm_q)});
  var tb;
  at(900,function(){tb=typingBubble()});
  at(1900,function(){
    if(tb)tb.remove();
    var b=nyxWrap();
    typeInto(b,d.dm_a1,function(){
      var plan=document.createElement('div');plan.className='plan';
      plan.innerHTML='<div class="plan-h">'+esc(d.dm_plan)+'</div>'+
        '<div class="plan-row">'+CK+'<span>'+esc(d.dm_i1)+'</span><span class="amt">faster boot</span></div>'+
        '<div class="plan-row">'+CK+'<span>'+esc(d.dm_i2)+'</span><span class="amt">safe</span></div>'+
        '<div class="plan-row">'+CK+'<span>'+esc(d.dm_i3)+'</span><span class="amt">+2.6 GB</span></div>'+
        '<div class="plan-row" style="color:var(--faint)"><span class="amt" style="margin-left:0">'+esc(d.dm_more)+'</span></div>'+
        '<div class="plan-actions"><button class="mini primary" id="apv">'+esc(d.dm_approve)+'</button><button class="mini">'+esc(d.dm_edit)+'</button></div>';
      b.appendChild(plan);
      at(1400,function(){var a=$('#apv');if(a)a.classList.add('clicked')});
      at(1750,function(){youMsg(d.dm_approve)});
      var tb2;at(2100,function(){tb2=typingBubble()});
      at(3100,function(){if(tb2)tb2.remove();var b2=nyxWrap();
        b2.innerHTML='<div class="done"><span class="ok">'+CK+'</span><span>'+esc(d.dm_a2)+'</span></div><toggle class="nyx-verify"><summary class="nyx-verify-chip"><span class="vok">✓</span> Verified<div class="nyx-verify-card"><div class="vrow"><b>What ran</b><span>Trimmed 14 startup apps, cleared 8.4 GB, closed 3 tasks</span></div><div class="vrow"><b>What changed</b><span>Startup list, temp cache, background processes</span></div><div class="vrow"><b>Reversible</b><span>Yes — one-click undo</span></div><div class="vrow"><b>Signed</b><span><code>a1f9…c7e2</code> · Ed25519</span></div></div></toggle>';
      });
      at(6800,function(){buildDemo(d)});
    });
  });
}

// ---- nav + progress ----
var nav=$('#nav'),prog=$('#progress');
function onScroll(){var y=scrollY||document.documentElement.scrollTop;nav.classList.toggle('scrolled',y>10);var h=document.documentElement.scrollHeight-innerHeight;prog.style.width=(h>0?(y/h*100):0)+'%'}
addEventListener('scroll',onScroll,{passive:true});onScroll();

apply(lang);
})();
</script>
<script>

NYXI.uk = {
  "Choose your brain":"Обери свій мозок",
  "One app. A model for every PC.":"Один застосунок. Модель для будь-якого ПК.",
  "Nyx isn't locked to a single model. Weak laptop or a beast rig - pick the size that runs smoothly on your hardware. On first launch Nyx checks your specs and pre-selects the best fit; you can switch anytime.":"Nyx не прив'язаний до однієї моделі. Слабкий ноутбук чи звір-збірка — обери розмір, що плавно працює на твоєму залізі. Під час першого запуску Nyx перевіряє твої характеристики й заздалегідь добирає найкращий варіант; змінити можна будь-коли.",
  "~1-2B params":"~1–2 млрд параметрів",
  "~3-4B params":"~3–4 млрд параметрів",
  "~7-8B params":"~7–8 млрд параметрів",
  "~3B params":"~14 млрд+ параметрів",
  "For older laptops and office PCs with no graphics card.":"Для старих ноутбуків та офісних ПК без відеокарти.",
  "The sweet spot for most modern laptops and desktops.":"Золота середина для більшості сучасних ноутбуків і настільних ПК.",
  "For gaming PCs and workstations with a real GPU.":"Для ігрових ПК і робочих станцій зі справжньою відеокартою.",
  "A light step up from Lite for everyday work on typical laptops.":"Для потужних збірок ентузіастів, яким потрібні найточніші відповіді.",
  "Most people pick this":"Вибір більшості",
  "Runs on":"Працює на",
  "Memory":"Пам'ять",
  "Feel":"Відчуття",
  "Best for":"Найкраще для",
  "CPU only":"Лише процесор",
  "CPU or entry GPU":"Процесор або початкова відеокарта",
  "8-12 GB VRAM GPU":"Відеокарта з 8–12 ГБ VRAM",
  "CPU or a basic laptop GPU":"Відеокарта з 24 ГБ+ VRAM",
  "3 GB+ RAM":"8 ГБ ОЗП",
  "8 GB+ RAM":"16 ГБ ОЗП",
  "16 GB+ RAM":"16 ГБ+ ОЗП",
  "6 GB+ RAM":"32 ГБ+ ОЗП",
  "Instant, snappy":"Миттєво, жваво",
  "Fast & noticeably smarter":"Швидко й помітно розумніше",
  "Deeper reasoning":"Глибші міркування",
  "Balanced speed and quality":"Найвища якість",
  "Quick tasks, files, everyday commands":"Швидкі задачі, файли, щоденні команди",
  "Daily driving, writing, light coding":"Щоденна робота, тексти, легкий код",
  "Coding, multi-step tasks, long context":"Код, багатокрокові задачі, довгий контекст",
  "Everyday assistant tasks":"Складні міркування, величезний контекст, дослідження",
  "Built to stay smooth.":"Створений залишатися плавним.",
  "Nyx runs models through QVAC's on-device runtime with memory-saving quantization (TurboQuant), so even the Lite tier stays responsive on modest hardware and bigger models don't eat all your VRAM. If your PC ever struggles, drop a tier and Nyx keeps up.":"Nyx запускає моделі через локальний рантайм QVAC з квантуванням, що заощаджує пам'ять (TurboQuant), тож навіть рівень Lite залишається чуйним на скромному залізі, а більші моделі не з'їдають усю твою відеопам'ять. Якщо ПК колись починає гальмувати — опустися на рівень нижче, і Nyx не відставатиме.",
  "Up and running in about a minute.":"Готово до роботи приблизно за хвилину.",
  "One download for Windows. No account, no setup maze - install it, pick a model that fits your PC, and start asking.":"Одне завантаження для Windows. Без облікового запису, без лабіринту налаштувань — встанови, обери модель під свій ПК і починай питати.",
  "Nyx for Windows":"Nyx для Windows",
  "Windows 10 / 11 · 64-bit · ~120 MB installer":"Windows 10 / 11 · 64-біт · інсталятор ~120 МБ",
  "Download for Windows →":"Завантажити для Windows →",
  "macOS and Linux builds are on the way. Today Nyx is tuned and tested for Windows.":"Збірки для macOS і Linux уже в дорозі. Сьогодні Nyx налаштований і протестований під Windows.",
  "Cost":"Вартість",
  "Account":"Обліковий запис",
  "Internet":"Інтернет",
  "Disk":"Диск",
  "Free & open source":"Безкоштовно та з відкритим кодом",
  "None needed":"Не потрібен",
  "Only to download - runs offline after":"Лише щоб завантажити — далі працює офлайн",
  "~120 MB app + 1-5 GB per model":"застосунок ~120 МБ + 1–5 ГБ на модель",
  "Download & install":"Завантаж і встанови",
  "Pick your model":"Обери модель",
  "It downloads once":"Завантажується один раз",
  "Just ask":"Просто спитай",
  "Grab the installer, run it, click through. No admin gymnastics, no bundled junk - about a minute start to finish.":"Візьми інсталятор, запусти, пройди кроки. Без танців із правами адміністратора, без вбудованого мотлоху — приблизно хвилина від початку до кінця.",
  "On first launch Nyx reads your hardware and recommends a model that will run smoothly.":"Під час першого запуску Nyx зчитує твоє залізо й рекомендує модель, яка працюватиме плавно.",
  "See which one fits your PC →":"Подивись, яка підійде твоєму ПК →",
  "Your model is fetched a single time (1-5 GB by tier) and stored locally. After that Nyx works with no internet at all.":"Твоя модель завантажується один раз (1–5 ГБ залежно від рівня) і зберігається локально. Після цього Nyx працює взагалі без інтернету.",
  "Type what you want in plain words. Nyx shows a plan, you approve, it acts - and every run is signed to ./evidence.":"Напиши, що хочеш, звичайними словами. Nyx показує план, ти схвалюєш, він діє — і кожен запуск підписується в ./evidence.",
  "Good questions":"Гарні запитання",
  "Everything you're probably wondering.":"Усе, про що ти напевно замислюєшся.",
  "Is my data actually private?":"Чи справді мої дані приватні?",
  "Completely. Everything runs on your machine - your files, your prompts, and the model itself never leave your PC. No account, no cloud, no telemetry. Pull out the network cable and Nyx still works.":"Цілком. Усе працює на твоїй машині — твої файли, твої запити та сама модель ніколи не залишають твій ПК. Без облікового запису, без хмари, без телеметрії. Витягни мережевий кабель — і Nyx усе одно працює.",
  "Will it slow down or lag my computer?":"Чи не сповільнить це мій комп'ютер, чи не гальмуватиме?",
  "Nyx is built to stay light. It runs a model sized for your hardware and only loads it while you're actually using it. On a modest PC, choose the Lite tier and it stays responsive - if things ever feel heavy, drop a tier and it speeds right back up.":"Nyx створений залишатися легким. Він запускає модель під розмір твого заліза й завантажує її лише поки ти справді нею користуєшся. На скромному ПК обери рівень Lite — і він залишається чуйним; якщо раптом стане важко, опустися на рівень нижче, і швидкість одразу повернеться.",
  "What if my PC is weak or a few years old?":"А якщо мій ПК слабкий або йому вже кілька років?",
  "You're covered. Nyx runs on CPU-only machines with 8 GB of RAM using the Lite model. On first launch it checks your specs and recommends the model that will actually run well - no guessing, no trial and error.":"Ти під захистом. Nyx працює на машинах лише з процесором і 8 ГБ ОЗП на моделі Lite. Під час першого запуску він перевіряє твої характеристики й рекомендує модель, яка реально піде добре — без здогадок, без спроб і помилок.",
  "Can I choose which model to use?":"Чи можу я обирати, яку модель використовувати?",
  "Yes - Nyx isn't tied to one model. Start with the recommended pick and switch to a bigger or smaller one whenever you like, right inside the app.":"Так — Nyx не прив'язаний до однієї моделі. Почни з рекомендованого варіанту і перемикайся на більший чи менший коли захочеш, прямо в застосунку.",
  "Compare the tiers →":"Порівняти рівні →",
  "Is it safe to let an AI touch my PC?":"Чи безпечно пускати ШІ до мого ПК?",
  "Nyx never acts on its own. It shows you a plain-English plan first, and nothing runs until you approve it. A validator blocks destructive commands, NetGuard blocks unknown network access, and every action is signed to ./evidence so you can check exactly what happened.":"Nyx ніколи не діє сам по собі. Спершу він показує план зрозумілою мовою, і нічого не запускається, доки ти не схвалиш. Валідатор блокує руйнівні команди, NetGuard блокує невідомий мережевий доступ, а кожна дія підписується в ./evidence, щоб ти міг точно перевірити, що сталося.",
  "Do I need to be technical to use it?":"Чи потрібно бути технарем, щоб цим користуватися?",
  "Not at all. You talk to it in normal language - \"clean up my downloads\", \"why is my PC slow\", \"rename these files by date\". There are no commands to memorize.":"Зовсім ні. Ти говориш із ним звичайною мовою — «прибери в завантаженнях», «чому гальмує мій ПК», «перейменуй ці файли за датою». Жодних команд запам'ятовувати не треба.",
  "Is it really free?":"Це справді безкоштовно?",
  "Yes, and it's open source under Apache-2.0. No trial, no subscription, no upsell. You can read the code, run the verifier, and check the signed receipts yourself.":"Так, і це відкритий код під Apache-2.0. Без пробного періоду, без підписки, без допродажів. Ти можеш прочитати код, запустити верифікатор і сам перевірити підписані квитанції.",
  "How much space does it need?":"Скільки місця потрібно?",
  "The app itself is small (~120 MB). Each model you pick is downloaded once and stored locally - roughly 1-2 GB for Lite up to about 5 GB for the Pro tier. You only ever download the models you choose.":"Сам застосунок маленький (~120 МБ). Кожна обрана модель завантажується один раз і зберігається локально — приблизно від 1–2 ГБ для Lite до близько 5 ГБ для Standard. Ти завантажуєш лише ті моделі, які обираєш."
};

/* ===== NYX-I18N-PLUS-CORE :: runtime engine ===== */
(function(){
  "use strict";
  var SUP={ru:1,uk:1,es:1,de:1,fr:1};
  var cache=new WeakMap();
  function norm(s){
    return s
      .replace(/[\u2018\u2019\u201B]/g,"'")
      .replace(/[\u201C\u201D]/g,'"')
      .replace(/[\u2012-\u2015\u2212]/g,"-")
      .replace(/\u00A0/g," ")
      .replace(/\s+/g," ")
      .trim();
  }
  function dict(l){ return (window.NYXI&&window.NYXI[l])||null; }
  function cur(){
    try{
      var ks=["nyx.lang","nyx-lang","lang"];
      for(var i=0;i<ks.length;i++){ var v=localStorage.getItem(ks[i]); if(v) return v.toLowerCase().slice(0,2); }
    }catch(e){}
    return (document.documentElement.getAttribute("lang")||"en").toLowerCase().slice(0,2);
  }
  function skip(n){
    var el=n.parentNode;
    while(el&&el.nodeType===1){
      var t=el.tagName;
      if(t==="SCRIPT"||t==="STYLE"||t==="NOSCRIPT"||t==="TEXTAREA") return true;
      if(el.hasAttribute&&(el.hasAttribute("data-i18n")||el.hasAttribute("data-nyx-skip"))) return true;
      if(el.id==="chatBody") return true;
      el=el.parentNode;
    }
    return false;
  }
  function walk(cb){
    var tw=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT,null,false);
    var n, list=[];
    while(n=tw.nextNode()){ if(n.nodeValue&&n.nodeValue.trim()&&!skip(n)) list.push(n); }
    for(var i=0;i<list.length;i++) cb(list[i]);
  }
  function apply(lang){
    var d=SUP[lang]?dict(lang):null;
    walk(function(n){
      var orig=cache.get(n);
      if(orig===undefined){ orig=n.nodeValue; cache.set(n,orig); }
      if(!d||lang==="en"){ if(n.nodeValue!==orig) n.nodeValue=orig; return; }
      var m=orig.match(/^(\s*)([\s\S]*?)(\s*)$/);
      var lead=m?m[1]:"", core=m?m[2]:orig, trail=m?m[3]:"";
      var t=d[norm(core)];
      if(t!=null){ var out=lead+t+trail; if(n.nodeValue!==out) n.nodeValue=out; }
      else if(n.nodeValue!==orig){ n.nodeValue=orig; }
    });
  }
  function run(){ try{ apply(cur()); }catch(e){} }
  if(document.readyState==="loading"){ document.addEventListener("DOMContentLoaded",run); } else { run(); }
  try{ new MutationObserver(run).observe(document.documentElement,{attributes:true,attributeFilter:["lang"]}); }catch(e){}
  document.addEventListener("click",function(e){
    var t=e.target;
    if(t&&t.closest&&t.closest(".menu button,[data-lang],[data-set-lang]")){ setTimeout(run,60); setTimeout(run,300); }
  },true);
  setTimeout(run,500); setTimeout(run,1500);
})();

</script>
<script>
/* NYX-I18N-PLUS-EXTRA :: es / de / fr */
window.NYXI = window.NYXI || {};

NYXI.es = {
  "Choose your brain":"Elige tu cerebro",
  "One app. A model for every PC.":"Una app. Un modelo para cada PC.",
  "Nyx isn't locked to a single model. Weak laptop or a beast rig - pick the size that runs smoothly on your hardware. On first launch Nyx checks your specs and pre-selects the best fit; you can switch anytime.":"Nyx no está atado a un solo modelo. Portátil modesto o equipo bestia: elige el tamaño que funcione con fluidez en tu hardware. En el primer arranque Nyx revisa tus specs y preselecciona la mejor opción; puedes cambiar cuando quieras.",
  "~1-2B params":"~1–2 mil M de parámetros",
  "~3-4B params":"~3–4 mil M de parámetros",
  "~7-8B params":"~7–8 mil M de parámetros",
  "~3B params":"~14 mil M+ de parámetros",
  "For older laptops and office PCs with no graphics card.":"Para portátiles antiguos y PC de oficina sin tarjeta gráfica.",
  "The sweet spot for most modern laptops and desktops.":"El punto ideal para la mayoría de portátiles y equipos modernos.",
  "For gaming PCs and workstations with a real GPU.":"Para PC gaming y estaciones de trabajo con una GPU de verdad.",
  "A light step up from Lite for everyday work on typical laptops.":"Para equipos entusiastas que quieren las respuestas más precisas.",
  "Most people pick this":"La elección de la mayoría",
  "Runs on":"Funciona en",
  "Memory":"Memoria",
  "Feel":"Sensación",
  "Best for":"Ideal para",
  "CPU only":"Solo CPU",
  "CPU or entry GPU":"CPU o GPU básica",
  "8-12 GB VRAM GPU":"GPU con 8–12 GB de VRAM",
  "CPU or a basic laptop GPU":"GPU con 24 GB+ de VRAM",
  "3 GB+ RAM":"8 GB de RAM",
  "8 GB+ RAM":"16 GB de RAM",
  "16 GB+ RAM":"16 GB+ de RAM",
  "6 GB+ RAM":"32 GB+ de RAM",
  "Instant, snappy":"Instantáneo, ágil",
  "Fast & noticeably smarter":"Rápido y notablemente más listo",
  "Deeper reasoning":"Razonamiento más profundo",
  "Balanced speed and quality":"Máxima calidad",
  "Quick tasks, files, everyday commands":"Tareas rápidas, archivos, comandos del día a día",
  "Daily driving, writing, light coding":"Uso diario, escritura, código ligero",
  "Coding, multi-step tasks, long context":"Programar, tareas de varios pasos, contexto largo",
  "Everyday assistant tasks":"Razonamiento intenso, contexto enorme, investigación",
  "Built to stay smooth.":"Hecho para ir fluido.",
  "Nyx runs models through QVAC's on-device runtime with memory-saving quantization (TurboQuant), so even the Lite tier stays responsive on modest hardware and bigger models don't eat all your VRAM. If your PC ever struggles, drop a tier and Nyx keeps up.":"Nyx ejecuta los modelos con el runtime en el dispositivo de QVAC y cuantización que ahorra memoria (TurboQuant), así que hasta el nivel Lite se mantiene ágil en hardware modesto y los modelos grandes no se comen toda tu VRAM. Si tu PC alguna vez sufre, baja un nivel y Nyx sigue el ritmo.",
  "Up and running in about a minute.":"Listo en más o menos un minuto.",
  "One download for Windows. No account, no setup maze - install it, pick a model that fits your PC, and start asking.":"Una sola descarga para Windows. Sin cuenta, sin laberinto de configuración: instálalo, elige un modelo que encaje con tu PC y empieza a pedir.",
  "Nyx for Windows":"Nyx para Windows",
  "Windows 10 / 11 · 64-bit · ~120 MB installer":"Windows 10 / 11 · 64 bits · instalador de ~120 MB",
  "Download for Windows →":"Descargar para Windows →",
  "macOS and Linux builds are on the way. Today Nyx is tuned and tested for Windows.":"Las versiones para macOS y Linux están en camino. Hoy Nyx está afinado y probado para Windows.",
  "Cost":"Coste",
  "Account":"Cuenta",
  "Internet":"Internet",
  "Disk":"Disco",
  "Free & open source":"Gratis y de código abierto",
  "None needed":"No hace falta",
  "Only to download - runs offline after":"Solo para descargar: después funciona sin conexión",
  "~120 MB app + 1-5 GB per model":"app de ~120 MB + 1–5 GB por modelo",
  "Download & install":"Descarga e instala",
  "Pick your model":"Elige tu modelo",
  "It downloads once":"Se descarga una vez",
  "Just ask":"Solo pide",
  "Grab the installer, run it, click through. No admin gymnastics, no bundled junk - about a minute start to finish.":"Coge el instalador, ejecútalo y sigue los pasos. Sin malabares de administrador ni basura incluida: un minuto de principio a fin.",
  "On first launch Nyx reads your hardware and recommends a model that will run smoothly.":"En el primer arranque Nyx lee tu hardware y recomienda un modelo que funcionará con fluidez.",
  "See which one fits your PC →":"Mira cuál encaja con tu PC →",
  "Your model is fetched a single time (1-5 GB by tier) and stored locally. After that Nyx works with no internet at all.":"Tu modelo se descarga una sola vez (1–5 GB según el nivel) y se guarda localmente. Después Nyx funciona sin nada de internet.",
  "Type what you want in plain words. Nyx shows a plan, you approve, it acts - and every run is signed to ./evidence.":"Escribe lo que quieres con palabras normales. Nyx muestra un plan, tú apruebas, actúa, y cada ejecución se firma en ./evidence.",
  "Good questions":"Buenas preguntas",
  "Everything you're probably wondering.":"Todo lo que probablemente te preguntas.",
  "Is my data actually private?":"¿Mis datos son realmente privados?",
  "Completely. Everything runs on your machine - your files, your prompts, and the model itself never leave your PC. No account, no cloud, no telemetry. Pull out the network cable and Nyx still works.":"Del todo. Todo se ejecuta en tu máquina: tus archivos, tus prompts y el propio modelo nunca salen de tu PC. Sin cuenta, sin nube, sin telemetría. Desenchufa el cable de red y Nyx sigue funcionando.",
  "Will it slow down or lag my computer?":"¿Ralentizará o hará que se cuelgue mi ordenador?",
  "Nyx is built to stay light. It runs a model sized for your hardware and only loads it while you're actually using it. On a modest PC, choose the Lite tier and it stays responsive - if things ever feel heavy, drop a tier and it speeds right back up.":"Nyx está hecho para ser ligero. Ejecuta un modelo del tamaño de tu hardware y solo lo carga mientras lo estás usando. En un PC modesto, elige el nivel Lite y se mantiene ágil; si en algún momento notas que va pesado, baja un nivel y vuelve a acelerar.",
  "What if my PC is weak or a few years old?":"¿Y si mi PC es débil o tiene unos años?",
  "You're covered. Nyx runs on CPU-only machines with 8 GB of RAM using the Lite model. On first launch it checks your specs and recommends the model that will actually run well - no guessing, no trial and error.":"Estás cubierto. Nyx funciona en equipos solo con CPU y 8 GB de RAM usando el modelo Lite. En el primer arranque revisa tus specs y recomienda el modelo que realmente irá bien: sin adivinar, sin prueba y error.",
  "Can I choose which model to use?":"¿Puedo elegir qué modelo usar?",
  "Yes - Nyx isn't tied to one model. Start with the recommended pick and switch to a bigger or smaller one whenever you like, right inside the app.":"Sí: Nyx no está atado a un solo modelo. Empieza con la opción recomendada y cambia a uno más grande o más pequeño cuando quieras, dentro de la propia app.",
  "Compare the tiers →":"Compara los niveles →",
  "Is it safe to let an AI touch my PC?":"¿Es seguro dejar que una IA toque mi PC?",
  "Nyx never acts on its own. It shows you a plain-English plan first, and nothing runs until you approve it. A validator blocks destructive commands, NetGuard blocks unknown network access, and every action is signed to ./evidence so you can check exactly what happened.":"Nyx nunca actúa por su cuenta. Primero te muestra un plan en lenguaje claro, y nada se ejecuta hasta que lo apruebas. Un validador bloquea los comandos destructivos, NetGuard bloquea el acceso de red desconocido, y cada acción se firma en ./evidence para que puedas comprobar exactamente qué pasó.",
  "Do I need to be technical to use it?":"¿Necesito ser técnico para usarlo?",
  "Not at all. You talk to it in normal language - \"clean up my downloads\", \"why is my PC slow\", \"rename these files by date\". There are no commands to memorize.":"Para nada. Le hablas en lenguaje normal: «ordena mis descargas», «por qué va lento mi PC», «renombra estos archivos por fecha». No hay comandos que memorizar.",
  "Is it really free?":"¿Es realmente gratis?",
  "Yes, and it's open source under Apache-2.0. No trial, no subscription, no upsell. You can read the code, run the verifier, and check the signed receipts yourself.":"Sí, y es de código abierto bajo Apache-2.0. Sin prueba, sin suscripción, sin ventas adicionales. Puedes leer el código, ejecutar el verificador y comprobar tú mismo los recibos firmados.",
  "How much space does it need?":"¿Cuánto espacio necesita?",
  "The app itself is small (~120 MB). Each model you pick is downloaded once and stored locally - roughly 1-2 GB for Lite up to about 5 GB for the Pro tier. You only ever download the models you choose.":"La app en sí es pequeña (~120 MB). Cada modelo que eliges se descarga una vez y se guarda localmente: más o menos 1–2 GB para Lite hasta unos 5 GB para Standard. Solo descargas los modelos que eliges."
};

